{
  "name": "quix-monorepo",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "bun --filter playground dev",
    "build": "bun --filter './packages/transform' build",
    "check-all": "biome check --write && bun test && bunx playwright test",
    "prepare": "husky",
    "test:e2e": "bunx playwright test",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5"
  },
  "dependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "packages/**/*.{test,spec}.{ts,tsx,js,jsx}": [
      "bun test"
    ]
  }
}
